{
  "name": "leaf-site",
  "compatibility_date": "2026-10-01",
  "main": "./src/worker.js",
  // The root runs the worker first, so curl gets the install script there.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/install",
      "/api/*"
    ]
  },
  "vars": {
    "DODO_ENV": "live_mode"
  },
  // Sponsor payments, written by the Dodo webhook.
  "kv_namespaces": [
    {
      "binding": "SPONSORS",
      "id": "06d77f59186841ee8d52e6eb7afa9cd5"
    }
  ],
  "routes": [
    {
      "pattern": "leaf.dipxsy.app",
      "custom_domain": true
    }
  ]
}
