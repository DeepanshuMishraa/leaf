{
  "name": "leaf-site",
  "compatibility_date": "2026-10-01",
  "main": "./src/worker.js",
  // The root runs the worker first, so curl gets the install script there.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/install", "/api/*"]
  },
  "vars": { "DODO_ENV": "live_mode" },
  // Sponsor payments, written by the Dodo webhook. Create it with
  // `bunx wrangler kv namespace create SPONSORS` and paste the id here.
  "kv_namespaces": [{ "binding": "SPONSORS", "id": "REPLACE_WITH_SPONSORS_KV_ID" }],
  "routes": [{ "pattern": "leaf.dipxsy.app", "custom_domain": true }]
}
