#compdef leaf
# Completions for leaf. Install: copy to a directory on $fpath, e.g.
#   cp completions/_leaf ~/.zsh/completions/   (then: fpath=(~/.zsh/completions $fpath); autoload -U compinit && compinit)

_leaf_refs() {
  local -a refs
  refs=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes refs/tags 2>/dev/null)"})
  compadd -a refs
}

_leaf_diff() {
  _arguments \
    '(-s --staged)'{-s,--staged}'[staged changes]' \
    '(-b --branch)'{-b,--branch}'[this branch against its base branch]' \
    '(-i --inline)'{-i,--inline}'[one column, removed lines above added ones]' \
    '--base=[compare against a base]:ref:_leaf_refs' \
    '(-r --range)'{-r,--range=}'[revision or revision range]:range:' \
    '--patch=[diff or patch file]:patch file:_files -g "(#i)*.(diff|patch)"' \
    '*:path, revision or GitHub url:_files'
}

_leaf() {
  local -a commands
  commands=(
    'open:Read a PDF, markdown file or web page'
    'diff:Review a diff'
    'pr:Pull requests and issues that concern you'
    'plan:Review a plan block by block and send a verdict'
    'review:Review changes file by file and send a verdict'
    'skills:Install the leaf skills for coding agents'
    'hook:Set up every agent CLI here for plan review'
    'comments:List saved diff comments'
    'ask:Ask an open agent about selected text'
    'rex:Add or remove the Rex command palette actions'
    'voice:Show or set the voice that reads aloud'
    'voices:Pick a voice from every voice there is'
    'agents:Pick the installed agent questions go to'
    'version:Print the installed version'
    'upgrade:Install the newest release'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'leaf command' commands
    return
  fi

  local subcommand=$words[2]
  words=("${(@)words[2,-1]}")
  (( CURRENT-- ))

  case $subcommand in
    open)
      # HEIC, HEIF, AVIF and JPEG XL need macOS's sips.
      local pictures='png|jpg|jpeg|jpe|jfif|gif|webp|bmp|ico|tif|tiff|tga|pnm|pbm|pgm|ppm|pam|qoi|hdr|exr|dds|ff|svg'
      [[ $OSTYPE == darwin* ]] && pictures+='|jxl|heic|heif|avif'
      _arguments "*:document:_files -g \"(#i)*.(pdf|epub|md|markdown|$pictures)\""
      ;;
    diff)
      _leaf_diff
      ;;
    plan)
      _arguments \
        '--wait[block until the review is sent and print it]' \
        '--print[print the review instead of sending it to the agent]' \
        '--reply-to=[send into this Rex block]:block:' \
        '--result=[write the review to this file]:file:_files' \
        '--title=[name shown for the plan]:title:' \
        '*:plan:_files -g "(#i)*.(md|markdown)"'
      ;;
    review)
      _arguments \
        '--wait[block until the review is sent and print it]' \
        '--print[print the review instead of sending it to the agent]' \
        '--reply-to=[send into this Rex block]:block:' \
        '--result=[write the review to this file]:file:_files' \
        '(-s --staged)'{-s,--staged}'[staged changes]' \
        '(-b --branch)'{-b,--branch}'[this branch against its base branch]' \
        '(-i --inline)'{-i,--inline}'[one column, removed lines above added ones]' \
        '--base=[compare against a base]:ref:_leaf_refs' \
        '(-r --range)'{-r,--range=}'[revision or revision range]:range:' \
        '--patch=[diff or patch file]:patch file:_files -g "(#i)*.(diff|patch)"' \
        '*:path, revision or GitHub url:_files'
      ;;
    skills | skill)
      if (( CURRENT == 2 )); then
        _values 'action' install uninstall status print
      elif [[ $words[2] == print ]]; then
        _values 'skill' leaf leaf-plan leaf-review
      fi
      ;;
    hook | hooks)
      if (( CURRENT == 2 )); then
        _values 'action' install uninstall status
      elif [[ $words[2] == install ]]; then
        _arguments \
          '(-y --yes)'{-y,--yes}'[write without asking]' \
          '(-n --dry-run)'{-n,--dry-run}'[show what would change without writing]'
      fi
      ;;
    comments)
      _arguments '--json[machine-readable JSON]'
      ;;
    ask)
      _arguments \
        '--title[document name quoted in the prompt]:title:' \
        '--question[question to send with the selection]:question:'
      ;;
    rex | plugin)
      _values 'action' install uninstall
      ;;
    voice)
      _values 'voice' \
        en-US-EmmaMultilingualNeural en-US-AriaNeural en-US-GuyNeural \
        en-GB-SoniaNeural en-GB-RyanNeural en-AU-NatashaNeural en-IN-NeerjaNeural
      ;;
    upgrade | update)
      _arguments '--check[only say if there is a newer release]'
      ;;
  esac
}

_leaf "$@"
