#compdef leaf
# Completions for leaf. Install: copy to a directory on $fpath, e.g.
#   cp completions/_leaf ~/.zsh/completions/   (then: autoload -U compinit && compinit)

_leaf_refs() {
  local -a refs
  refs=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes refs/tags 2>/dev/null)"})
  compadd -a refs
}

_leaf_diff() {
  _arguments -s \
    '(-s --staged)'{-s,--staged}'[staged changes]' \
    '(-b --branch)'{-b,--branch}'[this branch against its base branch]' \
    '(-i --inline)'{-i,--inline}'[one column, removed lines above added ones]' \
    '--base=[compare against a base]:ref:_leaf_refs' \
    '(-r --range)'{-r+,--range=}'[revision or revision range]:range:' \
    '--patch=[diff or patch file]:patch file:_files -g "*.(diff|patch)"' \
    '*:path, revision or GitHub url:_files'
}

_leaf() {
  local -a commands
  commands=(
    'open:Read a PDF, markdown file or web page'
    'diff:Review a diff'
    'pr:Read and act on your pull requests'
    'comments:List saved diff comments'
    'ask:Ask an open agent about selected text'
    'rex:Add or remove the Rex command palette actions'
    'voice:Show or set the voice that reads aloud'
    'voices:Pick a voice from every voice there is'
    'agents:Pick the installed agent questions go to'
    'version:Print the installed version'
    'upgrade:Install the newest release'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'leaf command' commands
    return
  fi

  local subcommand=$words[2]
  words=("${(@)words[2,-1]}")
  (( CURRENT-- ))

  case $subcommand in
    open)
      _arguments '*:document:_files -g "*.(pdf|epub|md|markdown)"'
      ;;
    diff)
      _leaf_diff
      ;;
    comments)
      _arguments '--json[machine-readable JSON]'
      ;;
    ask)
      _arguments \
        '--title=[document name quoted in the prompt]:title:' \
        '--question=[question to send with the selection]:question:'
      ;;
    rex | plugin)
      _values 'action' install uninstall
      ;;
    voice)
      _values 'voice' \
        en-US-EmmaMultilingualNeural en-US-AriaNeural en-US-GuyNeural \
        en-GB-SoniaNeural en-GB-RyanNeural en-AU-NatashaNeural en-IN-NeerjaNeural
      ;;
    upgrade | update)
      _arguments '--check[only say if there is a newer release]'
      ;;
  esac
}

_leaf "$@"
